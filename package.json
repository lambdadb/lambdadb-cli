{
  "name": "@functional-systems/lambdadb-cli",
  "version": "0.1.1-dev.1",
  "private": false,
  "description": "Project-scoped LambdaDB command-line tools",
  "type": "module",
  "bin": {
    "lambdadb": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "DESIGN.md",
    "VALIDATION.md",
    "CONTRIBUTING.md",
    "examples",
    "RELEASING.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "lint": "eslint .",
    "check:version": "node scripts/check-release.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:live": "npm run build && node --test test/live/*.test.mjs"
  },
  "dependencies": {
    "@functional-systems/lambdadb": "0.5.1",
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "globals": "^16.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambdadb/lambdadb-cli.git"
  },
  "homepage": "https://github.com/lambdadb/lambdadb-cli#readme",
  "bugs": {
    "url": "https://github.com/lambdadb/lambdadb-cli/issues"
  },
  "license": "Apache-2.0"
}
