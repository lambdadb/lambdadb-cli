{
  "name": "@functional-systems/lambdadb-cli",
  "version": "0.1.7",
  "private": false,
  "description": "LambdaDB CLI for account and project management, usage, data and coding agents",
  "type": "module",
  "bin": {
    "lambdadb": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "DESIGN.md",
    "ONBOARDING.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "examples",
    "skills",
    "RELEASING.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "lint": "eslint .",
    "check:version": "node scripts/check-release.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:live": "npm run build && node --test --test-concurrency=1 test/live/*.test.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@functional-systems/lambdadb": "0.11.0",
    "commander": "14.0.3",
    "fast-wrap-ansi": "0.2.2",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "globals": "^16.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambdadb/lambdadb-cli.git"
  },
  "homepage": "https://github.com/lambdadb/lambdadb-cli#readme",
  "bugs": {
    "url": "https://github.com/lambdadb/lambdadb-cli/issues"
  },
  "license": "Apache-2.0",
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.2"
  }
}
